{
  "name": "lattice",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "napi": {
    "name": "lattice_native",
    "triples": {
      "defaults": true,
      "additional": []
    }
  },
  "scripts": {
    "build:native": "napi build --platform --cargo-cwd src-tauri --dts index.d.ts --js index.js native",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "start": "electron --no-sandbox ."
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@tauri-apps/cli": "^2.2.0",
    "electron": "^30.5.1"
  }
}
